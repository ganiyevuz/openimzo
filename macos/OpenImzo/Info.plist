<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
		<string>uz</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Dated versions (YYYY.MM.DD), not semantic ones. This is an app a person
	     installs, not a library anyone links against: there is no API whose
	     stability a major number could promise, so the only question a version
	     has to answer here is "how old is the copy I am running", which a date
	     answers exactly. Zero-padded so the string sorts the same way the
	     integers compare, which is what lets a naive string comparison anywhere
	     downstream still get the order right. A second release on one day takes
	     a fourth component in CFBundleVersion only — CFBundleShortVersionString
	     is documented as at most three integers, and it is the one shown to
	     people. Set by hand at release time, and matched by the git tag. -->
	<key>CFBundleShortVersionString</key>
	<string>2026.09.11</string>
	<key>CFBundleVersion</key>
	<string>2026.09.11</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>OpenImzo</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>First run uses this to ask System Events to remove the original E-IMZO from your login items, if you choose to.</string>
</dict>
</plist>
