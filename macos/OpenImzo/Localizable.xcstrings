      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Names and Identifiers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать имена и идентификаторы"
