          }
        }
      }
    },
    "Replaces names, national identifiers, serial numbers and file paths with dots. Each key has its own button to show it again for a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces names, national identifiers, serial numbers and file paths with dots. Each key has its own button to show it again for a moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменяет имена, ПИНФЛ и ИНН, серийные номера и пути к файлам точками. У каждого ключа есть своя кнопка, чтобы показать его на время."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismlar, JShShIR va STIR, seriya raqamlari va fayl yoʻllarini nuqtalar bilan almashtiradi. Har bir kalitning uni vaqtincha koʻrsatadigan oʻz tugmasi bor."
          }
        }
      }
    },
