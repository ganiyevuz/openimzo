    "Activity persistence is off — showing only what has arrived since this app started. Turn it on in Settings to keep history across launches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity persistence is off — showing only what has arrived since this app started. Turn it on in Settings to keep history across launches."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение активности отключено — показано только то, что поступило с момента запуска приложения. Включите его в Настройке, чтобы сохранять историю между запусками."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faoliyatni saqlash oʻchirilgan — faqat dastur ishga tushgandan beri kelgan maʼlumotlar koʻrsatilmoqda. Ishga tushirishlar oraligʻida tarixni saqlash uchun uni Sozlamada yoqing."
          }
        }
      }
    },
    "No Activity Yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Activity Yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активности пока нет"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali faoliyat yoʻq"
          }
        }
      }
    },
    "Calls a website makes to %@ will appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls a website makes to %@ will appear here."
          }
        },
        "ru": {
          "stringUnit": {
