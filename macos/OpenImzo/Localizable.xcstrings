    "Remove it from your login items": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove it from your login items"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать его из входа в систему"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni tizimga kirishdan olib tashlash"
          }
        }
      }
    },
    "You can also do this yourself in System Settings, under General > Login Items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also do this yourself in System Settings, under General > Login Items."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы также можете сделать это вручную в Системных настройках, в разделе Основные → Элементы входа."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buni Tizim sozlamalarida, Umumiy → Kirish elementlari boʻlimida ham qoʻlda bajarishingiz mumkin."
          }
        }
      }
    },
    "Websites talk to %@ over a local, encrypted connection. Trusting its certificate in your login keychain stops your browser from warning about it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites talk to %@ over a local, encrypted connection. Trusting its certificate in your login keychain stops your browser from warning about it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-сайты обращаются к %@ по локальному зашифрованному соединению. Доверие к его сертификату в связке ключей входа избавит браузер от предупреждений о нём."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Veb-saytlar %@ bilan mahalliy, shifrlangan ulanish orqali bogʻlanadi. Uning sertifikatiga kirish kalitlar toʻplamida ishonish brauzeringizni bu haqidagi ogohlantirishlardan xalos qiladi."
          }
        }
      }
    },
    "Start %@ automatically when you log in, the way the original did.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start %@ automatically when you log in, the way the original did."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать %@ автоматически при входе в систему, как это делал оригинал."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’ni tizimga kirishda original kabi avtomatik ishga tushirish."
          }
        }
      }
    },
