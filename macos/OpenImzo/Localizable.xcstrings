    "Sites that verify an API key or that you've allowed will appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites that verify an API key or that you've allowed will appear here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся сайты, чей API-key подтверждён или которым вы разрешили доступ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "API-key tasdiqlangan yoki siz ruxsat bergan saytlar shu yerda koʻrinadi."
          }
        }
      }
    },
