    "This key's certificate cannot be read without its password. What is shown above comes from the file's own alias.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key's certificate cannot be read without its password. What is shown above comes from the file's own alias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат этого ключа нельзя прочитать без пароля. Показанное выше взято из псевдонима (alias) самого файла."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kalitning sertifikatini parolsiz oʻqib boʻlmaydi. Yuqorida koʻrsatilgani faylning oʻz taxallusidan (alias) olingan."
          }
        }
      }
    },
